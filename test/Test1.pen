
def Character = new object
	.text => <b|color=@.color>@.name</>
	.name => @.f_name @.l_name


def Beatrix = new Character
	.f_name => Beatrix
	.l_name => Denali
	.friend = Rubin.spouse


def Esther = new Character
	.color = #0000ff
	.f_name => Esther
		[ru] Эстер
		[ja] エスター
		[zh] 以斯帖
	.l_name => Zeitzen
	.spouse = Rubin

def Rubin = new Character
	.age = 24
	.color = #ff0000
	.f_name => Rubin
		[ru] Рубин
		[ja] ルービン
		[zh] 鱼宾
	.l_name => Redding
	.spouse = Esther

