
def Character = new object
	.name => @.f_name @.l_name
	.filter = "asdf" -> "whassup"


def Beatrix = new Character
	.f_name => Beatrix
	.l_name => Denali
	.friend = Rubin.spouse


def Esther = new Character
	.f_name => Esther
		[ru] Эстер
		[ja] エスター
		[zh] 以斯帖
	.l_name => Zeitzen
	.spouse = Rubin

def Rubin = new Character
	.age = 24
	.f_name => Rubin
		[ru] Рубин
		[ja] ルービン
		[zh] 鱼宾
	.l_name => Redding
	.spouse = Esther

