[gd_resource type="Resource" format=3 uid="uid://d2aki1wcv4u6i"]

[sub_resource type="GDScript" id="GDScript_js853"]
script/source = "extends PennyDecorationEffect

func encounter_start(inst: PennyDecorationInstance, typewriter: TypewriterTextLabel, wait: bool):
	if not wait:
		return
	
	var duration : float = inst.args.delay
	if inst.args.scaled and typewriter.speed_percent > 0.0:
		duration /= typewriter.speed_percent
	
	if duration <= 0.05:
		await typewriter.get_tree().process_frame
		return

	typewriter.pausing = true
	typewriter.delay_timer.wait_time = duration
	typewriter.delay_timer.start()
	await typewriter.delay_timer.timeout

	typewriter.pausing = false
"

[resource]
script = SubResource("GDScript_js853")
default_args = Dictionary[StringName, Variant]({
&"delay": 0.333,
&"scaled": false
})
closable = false
id = &"delay"
