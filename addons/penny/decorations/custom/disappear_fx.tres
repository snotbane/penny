[gd_resource type="RichTextEffect" format=3 uid="uid://mf0m5antd0fx"]

[sub_resource type="GDScript" id="GDScript_le1he"]
script/source = "extends TypewriterTextEffect

func _process_custom_fx_typewriter(char_fx: CharFXTransform, inst: PennyDecorationInstance, typewriter: TypewriterTextLabel, visible_duration: float) -> bool:
	var reset_duration : float = float(Time.get_ticks_usec() - typewriter.time_reseted_stamp) * 0.00_000_1
	var alpha : float = reset_duration * inst.args.speed
	if alpha < 0.0:
		return true
	
	alpha = clampf(alpha, 0.0, 1.0)
	char_fx.color = lerp(
		char_fx.color,
		char_fx.color * Color.TRANSPARENT,
		alpha
	)
	
	var scale := 1.0
	char_fx.transform.origin = lerp(
		char_fx.transform.origin,
		char_fx.transform.origin + inst.args.offset / scale,
		alpha
	)
	
	return true
"

[resource]
script = SubResource("GDScript_le1he")
