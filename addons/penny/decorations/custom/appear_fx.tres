[gd_resource type="RichTextEffect" format=3 uid="uid://dgu6cke4vspb7"]

[sub_resource type="GDScript" id="GDScript_40ejm"]
script/source = "extends TypewriterTextEffect

func _process_custom_fx_typewriter(char_fx: CharFXTransform, inst: PennyDecorationInstance, typewriter: TypewriterTextLabel, visible_duration: float) -> bool:
	var alpha : float = visible_duration * inst.args[&\"speed\"]
	if alpha > 1.0:
		return true
	
	alpha = clampf(alpha, 0.0, 1.0)
	char_fx.color = lerp(
		char_fx.color * Color.TRANSPARENT,
		char_fx.color,
		alpha
	)
	
	char_fx.transform.origin = lerp(
		char_fx.transform.origin + inst.args[&\"offset\"],
		char_fx.transform.origin,
		alpha
	)
	
	return true
"

[resource]
script = SubResource("GDScript_40ejm")
